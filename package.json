{
  "devDependencies": {
    "@types/google-apps-script": "^2.0.13",
    "copyfiles": "^2.4.1",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && copyfiles -f src/appsscript.json dist",
    "test": "npm run build && node --test \"src\\tests\\**\\*.test.js\"",
    "push": "npm run build && clasp push",
    "deploy": "node src/deploy.js"
  }
}
